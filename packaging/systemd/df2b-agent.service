[Unit]
Description=dist-f2b agent
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
# DF2B_ENROLL_TOKEN=… for the first start with a controller
EnvironmentFile=-/etc/df2b/agent.env
ExecStart=/usr/bin/df2b-agent --config /etc/df2b/agent.toml
# applies agent.toml without a restart (as df2bctl --local config reload)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

User=df2b
Group=df2b
SupplementaryGroups=systemd-journal adm
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

StateDirectory=df2b
# agent.redb holds offenders and queued reports with sample log lines
StateDirectoryMode=0700
UMask=0077
RuntimeDirectory=df2b
ConfigurationDirectory=df2b

# firewall = "ipset" (iptables) additionally needs, in a drop-in
# (systemctl edit df2b-agent):
#   AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
#   CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
#   ReadWritePaths=-/run/xtables.lock

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# System calls: what services need (systemd's @system-service), without
# @privileged and @resources; anything else fails with EPERM. Programs the
# agent starts (nft, ipset, iptables, firewall_exec) inherit this; for an
# exec program that needs more, add e.g. SystemCallFilter=@privileged in a
# drop-in. Checked with strace and, in CI, under systemd with the nftables
# and ipset backends (packaging/test/systemd-e2e.sh).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
