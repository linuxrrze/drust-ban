[Unit]
Description=dist-f2b agent
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
# DF2B_ENROLL_TOKEN=… for the first start with a controller
EnvironmentFile=-/etc/df2b/agent.env
ExecStart=/usr/bin/df2b-agent --config /etc/df2b/agent.toml
# applies agent.toml without a restart (as df2bctl --local config reload)
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

User=df2b
Group=df2b
SupplementaryGroups=systemd-journal adm
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

StateDirectory=df2b
RuntimeDirectory=df2b
ConfigurationDirectory=df2b

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
