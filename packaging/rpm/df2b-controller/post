# shellcheck shell=sh
# %post of df2b-controller ($1: 1 = installation, 2 = upgrade)
# (DynamicUser=yes: no user to create)

if [ "$1" -eq 1 ]; then
    # enabled and started on installation, like the Debian package
    # (not the Fedora/RHEL preset convention: the project's choice)
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable --now df2b-controller.service >/dev/null 2>&1 || :
fi
