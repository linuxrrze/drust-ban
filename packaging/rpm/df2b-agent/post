# shellcheck shell=sh
# %post of df2b-agent ($1: 1 = installation, 2 = upgrade)

# the df2b user (User= of df2b-agent.service) from the sysusers.d file
systemd-sysusers /usr/lib/sysusers.d/df2b-agent.conf || :

if [ "$1" -eq 1 ]; then
    # like %systemd_post: enable according to the systemd presets
    # (Fedora/RHEL default: disabled), never start on installation
    systemctl --no-reload preset df2b-agent.service >/dev/null 2>&1 || :
fi
