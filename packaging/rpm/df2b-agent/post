# shellcheck shell=sh
# %post of df2b-agent ($1: 1 = installation, 2 = upgrade)

# the df2b user (User= of df2b-agent.service) from the sysusers.d file
systemd-sysusers /usr/lib/sysusers.d/df2b-agent.conf || :

if [ "$1" -eq 1 ]; then
    # enabled and started on installation, like the Debian package
    # (not the Fedora/RHEL preset convention: the project's choice)
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable --now df2b-agent.service >/dev/null 2>&1 || :
fi
